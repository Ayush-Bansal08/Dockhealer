    {"id": "stop-bad-pin",         "kind": "inject", "project": "examples/broken/flask_bad_pin", "dockerfile": "failures/flask_bad_pin__good_dockerfile_bad_project.Dockerfile", "expect_category": "DEPENDENCY_IN_PROJECT", "expect_outcome": "human_required"}
